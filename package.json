{
  "name": "nova-assistant",
  "productName": "Nova",
  "version": "0.1.0",
  "description": "Nova — a voice-first desktop AI assistant",
  "author": "Nova",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-assistant/nova"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mwl",
    "test:router": "node src/main/test-router.js",
    "test:permissions": "node src/main/test-permissions.js",
    "test:vision": "node src/main/test-vision.js",
    "test:control": "node src/main/test-control.js",
    "test:agent": "node src/main/test-agent.js",
    "test:files": "node src/main/test-files.js",
    "test": "npm run test:permissions && npm run test:vision && npm run test:control && npm run test:agent && npm run test:files && npm run test:notes && npm run test:kb && npm run test:automation && npm run test:event-triggers && npm run test:memory && npm run test:screenshot-note && npm run test:snooze-reminder && npm run test:command-palette && npm run test:themes && npm run test:task-stats && npm run test:palette-ranking",
    "test:event-triggers": "node src/main/test-event-triggers.js",
    "test:memory": "node src/main/test-memory.js",
    "test:command-palette": "node src/main/test-command-palette.js",
    "test:task-stats": "node src/main/test-task-stats.js",
    "test:palette-ranking": "node src/main/test-palette-ranking.js",
    "test:themes": "node src/main/test-themes.js",
    "test:screenshot-note": "node src/main/test-screenshot-note.js",
    "test:snooze-reminder": "node src/main/test-snooze-reminder.js",
    "test:notes": "node src/main/test-notes.js",
    "test:kb": "node src/main/test-kb.js",
    "test:automation": "node src/main/test-automation.js",
    "smoke:auto": "node scripts/smoke-auto-e2e.js"
  },
  "build": {
    "appId": "com.nova.assistant",
    "productName": "Nova",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "nsis": {
        "oneClick": false
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@picovoice/porcupine-node": "^4.0.2",
    "@picovoice/porcupine-web": "^4.0.1",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^5.0.0",
    "electron-log": "^5.1.2",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "dmg-license": "^1.0.11",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.33.5"
    }
  }
}
